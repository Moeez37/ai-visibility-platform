# Set one key. With neither, the pipeline runs in labelled offline demo mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# auto | anthropic | openai | offline. auto prefers Anthropic, then OpenAI, then offline.
LLM_PROVIDER=auto
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-4o

DATABASE_URL=sqlite:///dev.db
FLASK_ENV=development
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:4200
